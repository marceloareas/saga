                .IncludeMultiple(includeProperties)
                .ToListAsync();
        }

        /// <inheritdoc />
        public virtual async Task<IEnumerable<TEntity>> GetAllAsync(
            Expression<Func<TEntity, bool>> predicate,
            params Expression<Func<TEntity, object>>[] includeProperties)
        {
            return await _dbSet
                .Where(e => !e.IsDeleted)
                .Where(predicate)
                .IncludeMultiple(includeProperties)
                .ToListAsync();
        }

                /// <inheritdoc />
